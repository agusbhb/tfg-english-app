# Sustituir TODOS los marcadores; usar valores aleatorios hexadecimales.
# Instalación NUEVA. Para adoptar fase 3, usar Use-Phase3Environment.ps1; no copiar esta plantilla sobre .env.
COMPOSE_PROJECT_NAME=trainer
MONGODB_VOLUME_NAME=trainer_mongodb_data
MONGODB_VOLUME_EXTERNAL=false
MONGO_ROOT_USER=trainer_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_APP_USER=trainer_app
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
MONGODB_DB=trainer
# Compose construye la URI con el usuario de aplicación. Esta URI sirve
# solo si se ejecuta Python fuera de Compose con una instancia local propia.
MONGODB_URI=mongodb://trainer_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/trainer?authSource=trainer
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
BANK_REFILL_THRESHOLD=20
BANK_REFILL_BATCH_SIZE=30
# Ensayo manual: mantener false incluso después de introducir la clave.
BANK_REFILL_ENABLED=false
# Límite total de llamadas por lote automático; también limita --modo lote del preview.
BANK_GENERATION_MAX_ROUNDS=3
# Proveedor operativo: Anthropic directo.
# Introducir la clave real únicamente en .env; no hay proveedor alternativo.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=4096
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MONGO_EXPRESS_USER=trainer_viewer
MONGO_EXPRESS_PASSWORD=CHANGE_ME_EXPRESS_PASSWORD
