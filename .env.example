# Sustituir TODOS los marcadores; usar valores aleatorios hexadecimales.
MONGO_ROOT_USER=trainer_admin
MONGO_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
MONGO_APP_USER=trainer_app
MONGO_APP_PASSWORD=CHANGE_ME_APP_PASSWORD
MONGODB_DB=trainer
# Compose construye la URI con el usuario de aplicación. Esta URI sirve
# solo si se ejecuta Python fuera de Compose con una instancia local propia.
MONGODB_URI=mongodb://trainer_app:CHANGE_ME_APP_PASSWORD@127.0.0.1:27017/trainer?authSource=trainer
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET
ACCESS_TOKEN_EXPIRE_MINUTES=30
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
MONGO_EXPRESS_USER=trainer_viewer
MONGO_EXPRESS_PASSWORD=CHANGE_ME_EXPRESS_PASSWORD
